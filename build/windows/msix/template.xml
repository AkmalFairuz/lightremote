<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="lightremote-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\AkmalFairuz\LightRemote">
    </Installer>
    <PackageInformation
        PackageName="LightRemote"
        PackageDisplayName="LightRemote"
        PublisherName="CN=AkmalFairuz"
        PublisherDisplayName="AkmalFairuz"
        Version="0.1.0.0"
        PackageDescription="A lightremote-desktop application">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="com.akmalfairuz.lightremote"
                Description="A lightremote-desktop application"
                DisplayName="LightRemote"
                ExecutableName="lightremote-desktop"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>LightRemote</DisplayName>
            <PublisherDisplayName>AkmalFairuz</PublisherDisplayName>
            <Description>A lightremote-desktop application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="lightremote-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
